# ---------------------------------------------------------------------------
# Node
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# Banco de dados (Neon)
# ---------------------------------------------------------------------------
# Conexão "pooled" (usada em runtime pela aplicação, via driver serverless do Neon).
# Copie do dashboard do Neon a connection string que contém "-pooler" no host.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Conexão direta (sem pooler) — usada só pelo Prisma para rodar migrations.
DIRECT_URL="postgresql://user:password@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Vercel Blob (upload de arquivos)
# ---------------------------------------------------------------------------
# Gerado ao habilitar um Blob Store no projeto Vercel (Storage > Blob).
BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# Inngest (jobs em background, notificações, retentativas)
# ---------------------------------------------------------------------------
# Em dev local, não são necessários — o `inngest-cli dev` descobre o endpoint
# /api/inngest automaticamente. Preencher só em produção (dashboard do Inngest).
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ---------------------------------------------------------------------------
# Segurança
# ---------------------------------------------------------------------------
# Assina a sessão interna (JWT curto emitido após o handshake com o Bitrix24).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_JWT_SECRET="gere-um-valor-aleatorio-de-32-bytes-ou-mais"

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"
LOG_LEVEL="debug"

# ---------------------------------------------------------------------------
# Bitrix24 — Aplicativo Local (Fase 1)
# ---------------------------------------------------------------------------
# Client ID / Client Secret mostrados pelo Bitrix24 após cadastrar o Aplicativo
# Local (tipo Servidor, com interface).
BITRIX_CLIENT_ID=""
BITRIX_CLIENT_SECRET=""

# Chave própria (NUNCA reaproveitar o SESSION_JWT_SECRET) para criptografar em
# repouso os tokens do Bitrix24 (accessToken/refreshToken) salvos em BitrixPortal.
# Precisa decodificar, em base64, para exatamente 32 bytes. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BITRIX_TOKEN_ENCRYPTION_KEY=""

# Lista (separada por vírgula) de origens extras autorizadas no `frame-ancestors`
# do CSP, além dos domínios de portais BitrixPortal com status ACTIVE — útil para
# liberar um domínio antes mesmo de existir uma instalação ativa (ex.: homolog).
# Ex.: "https://empresa.bitrix24.com.br,https://empresa-homolog.bitrix24.com.br"
BITRIX_EXTRA_FRAME_ANCESTORS=""

# Lista (CSV) de administradores extras, além de quem instalou o app.
# Formato "portalId:bitrixUserId" (o portalId é o ID INTERNO do BitrixPortal,
# não o memberId do Bitrix24) — o prefixo do portal é obrigatório: uma entrada
# sem ele (ex. "42" sozinho) é ignorada, nunca vira acesso global. Isso evita
# que o mesmo bitrixUserId "vaze" como admin em outro portal. Heurística
# temporária da Fase 1, substituída pelo módulo de permissões na Fase 4 — ver
# src/modules/bitrix/admin.ts. Ex.: "clabc123:42,clxyz789:108"
BITRIX_EXTRA_ADMIN_USER_IDS=""

# Integração GLPI — segredo exclusivo do conector local. Nunca usar token do
# Bitrix, nem salvar os tokens do GLPI aqui no repositório.
GLPI_SYNC_TOKEN="gere-um-segredo-aleatorio-com-32-bytes-ou-mais"
COLLECTOR_SYNC_TOKEN="gere-um-segredo-aleatorio-com-32-bytes-ou-mais"
